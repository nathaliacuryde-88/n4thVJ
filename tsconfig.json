{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "useDefineForClassFields": true,

    "strict": true,
    /* The renderers are three.js-style classes: fields are assigned in an
       init() the constructor calls, which TS cannot see through. Every other
       strict check stays on. */
    "strictPropertyInitialization": false,

    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": { "@/*": ["./src/app/*"] }
  },
  "include": ["src"]
}
